#!/usr/bin/env bash
# Test double for curl: logs the call. With -o it writes "{}" there (and -w prints 200);
# otherwise it prints $FAKE_DIR/curl-stdout, or "{}". $FAKE_DIR/curl-fail makes it fail like -f.
set -u
echo "curl $*" >>"$FAKE_DIR/curl.log"
if [[ -f "$FAKE_DIR/curl-fail" ]]; then
  echo "curl: (22) The requested URL returned error: 403" >&2
  exit 22
fi
# The module's variables.tf at git ref R: $FAKE_DIR/ref-variables-R, $FAKE_DIR/ref-variables,
# or one with the real-time GKE module.
if [[ "$*" == *raw.githubusercontent.com* ]]; then
  ref="$*"; ref="${ref##*integration/}"; ref="${ref%%/*}"
  cat "$FAKE_DIR/ref-variables-$ref" 2>/dev/null || cat "$FAKE_DIR/ref-variables" 2>/dev/null ||
    echo 'variable "gke_org_level_sink" {}'
  exit 0
fi
to_file=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) echo '{}' >"$2"; to_file=true; shift 2 ;;
    -w) printf 200; shift 2 ;;
    --data-binary) [[ "$2" == @- ]] && cat >>"$FAKE_DIR/curl.body"; shift 2 ;;
    *) shift ;;
  esac
done
if [[ "$to_file" != true ]]; then
  cat "$FAKE_DIR/curl-stdout" 2>/dev/null || echo '{}'
fi
